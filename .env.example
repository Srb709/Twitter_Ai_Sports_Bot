# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/sports_engine"

# ─── X / Twitter credentials (used by scripts/auth-x.ts) ────────────────────
X_USERNAME="your_twitter_handle"
X_EMAIL="your_twitter_email@example.com"
X_PASSWORD="your_twitter_password"

# ─── AI provider (choose one) ─────────────────────────────────────────────────
AI_PROVIDER="anthropic"          # "anthropic" or "openai"
AI_MODEL="claude-haiku-4-5"      # or "gpt-4o-mini" for OpenAI

ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."          # only needed if AI_PROVIDER=openai

# ─── Budget cap ───────────────────────────────────────────────────────────────
CLAUDE_MONTHLY_BUDGET_USD="20"   # hard stop when AI spend hits this

# ─── Mobile web app ───────────────────────────────────────────────────────────
APP_PASSWORD="changeme"          # password to access the PWA
NEXT_PUBLIC_APP_NAME="Sports Engine"
NEXT_PUBLIC_THEME_COLOR="#0f172a"
NEXT_PUBLIC_AI_PROVIDER="anthropic"
NEXT_PUBLIC_BUDGET_USD="20"

# ─── Worker settings ──────────────────────────────────────────────────────────
WORKER_SCAN_INTERVAL_MINUTES="30"   # how often to scan each account
WORKER_MAX_SCROLLS="5"              # how far to scroll each timeline

# ─── File paths ───────────────────────────────────────────────────────────────
AUTH_STATE_PATH="auth-state/x-session.json"
MEDIA_DIR="data/media"
SCREENSHOT_DIR="data/screenshots"
